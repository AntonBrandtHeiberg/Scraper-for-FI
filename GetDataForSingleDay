import sys
from ast import arg
import yfinance as yf
import pandas as pd

def getStockData(stock, startDate, endDate):
    stockData = yf.download(stock, start = startDate, end = endDate)
    return stockData
    
result = getStockData(sys.argv[1], sys.argv[2], sys.argv[3]) #Parameters are stock, startdate and enddate
print(result['Close'].values[0])
