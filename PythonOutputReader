static List<double> Trim(string input)
        {
            List<double> output = new List<double>();
            using (System.IO.StringReader reader = new System.IO.StringReader(input))
            {
                string line;
                while ((line = reader.ReadLine()) != null)
                {
                    try
                    {
                        output.Add(double.Parse(line));
                    }
                    catch(Exception e)
                    {
                        
                    }
                }
            }
            return output;

        }
